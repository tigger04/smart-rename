#!/usr/bin/env bash
# ABOUTME: Smart file renaming using AI to generate descriptive filenames
# ABOUTME: Simple, focused implementation that actually works

set -euo pipefail

VERSION="5.23.10"
SCRIPT_NAME="smart-rename"
CONFIG_DIR="$HOME/.config/smart-rename"
CONFIG_FILE="$CONFIG_DIR/config.yaml"

# Patched by Homebrew inreplace; empty means "not set"
SMART_RENAME_SHARE_DIR="${SMART_RENAME_SHARE_DIR:-}"

# Emergency fallback defaults — used ONLY when config.example.yaml is not found
# The real defaults live in config.example.yaml (single source of truth)
PROMPT_TEMPLATE=""
CLASSIFY_PROMPT=""
RECEIPT_PROMPT=""
BASE_CURRENCY="EUR"
OLLAMA_MODEL="smart-rename"
OPENAI_MODEL="gpt-4o-mini"
CLAUDE_MODEL="claude-haiku-4-5-20251001"
MAX_CONTENT_LENGTH=5000
API_TIMEOUT=30
PROVIDER_PREFERENCE=(ollama openai claude)

# Resolve the share directory where config.example.yaml and Modelfile live
resolve_share_dir() {
    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

    local candidates=(
        "${SMART_RENAME_SHARE_DIR}"
        "$script_dir"
        "/opt/homebrew/share/smart-rename"
        "/usr/local/share/smart-rename"
    )

    for dir in "${candidates[@]}"; do
        if [[ -n "$dir" && -d "$dir" && -f "$dir/config.example.yaml" ]]; then
            echo "$dir"
            return 0
        fi
    done
    # Fallback to script dir even if config.example.yaml isn't there
    echo "$script_dir"
}

# Load values from a YAML config file into global variables
# Only overrides variables for keys explicitly set in the file
_load_yaml_config() {
    local config_path="$1"

    if [[ ! -f "$config_path" ]]; then
        return 0
    fi

    if ! command -v yq >/dev/null 2>&1; then
        return 0
    fi

    local val

    if val=$(yq eval '.prompt.template // ""' "$config_path" 2>/dev/null) && [[ -n "$val" ]]; then
        PROMPT_TEMPLATE="$val"
    fi

    if val=$(yq eval '.prompt.classify // ""' "$config_path" 2>/dev/null) && [[ -n "$val" ]]; then
        CLASSIFY_PROMPT="$val"
    fi

    if val=$(yq eval '.prompt.receipt // ""' "$config_path" 2>/dev/null) && [[ -n "$val" ]]; then
        RECEIPT_PROMPT="$val"
    fi

    if val=$(yq eval '.currency.base // ""' "$config_path" 2>/dev/null) && [[ -n "$val" ]]; then
        BASE_CURRENCY="$val"
    fi

    if val=$(yq eval '.api.ollama.model // ""' "$config_path" 2>/dev/null) && [[ -n "$val" ]]; then
        OLLAMA_MODEL="$val"
    fi

    if val=$(yq eval '.api.openai.model // ""' "$config_path" 2>/dev/null) && [[ -n "$val" ]]; then
        OPENAI_MODEL="$val"
    fi

    if val=$(yq eval '.api.claude.model // ""' "$config_path" 2>/dev/null) && [[ -n "$val" ]]; then
        CLAUDE_MODEL="$val"
    fi

    # OpenAI key: key_command > key > env var
    local openai_key_resolved=false
    if val=$(yq eval '.api.openai.key_command // ""' "$config_path" 2>/dev/null) && [[ -n "$val" ]]; then
        local cmd_output
        if cmd_output=$(bash -c "$val" 2>/dev/null) && [[ -n "$cmd_output" ]]; then
            export OPENAI_API_KEY="$cmd_output"
            openai_key_resolved=true
        else
            echo "Warning: api.openai.key_command failed: $val" >&2
        fi
    fi
    if [[ "$openai_key_resolved" != "true" ]]; then
        if val=$(yq eval '.api.openai.key // ""' "$config_path" 2>/dev/null) && [[ -n "$val" ]]; then
            export OPENAI_API_KEY="$val"
        fi
    fi

    # Claude key: key_command > key > env var
    local claude_key_resolved=false
    if val=$(yq eval '.api.claude.key_command // ""' "$config_path" 2>/dev/null) && [[ -n "$val" ]]; then
        local cmd_output
        if cmd_output=$(bash -c "$val" 2>/dev/null) && [[ -n "$cmd_output" ]]; then
            export CLAUDE_API_KEY="$cmd_output"
            claude_key_resolved=true
        else
            echo "Warning: api.claude.key_command failed: $val" >&2
        fi
    fi
    if [[ "$claude_key_resolved" != "true" ]]; then
        if val=$(yq eval '.api.claude.key // ""' "$config_path" 2>/dev/null) && [[ -n "$val" ]]; then
            export CLAUDE_API_KEY="$val"
        fi
    fi

    if val=$(yq eval '.processing.max_content_length // ""' "$config_path" 2>/dev/null) && [[ -n "$val" ]]; then
        MAX_CONTENT_LENGTH="$val"
    fi

    if val=$(yq eval '.api.ollama.timeout // ""' "$config_path" 2>/dev/null) && [[ -n "$val" ]]; then
        API_TIMEOUT="$val"
    fi

    local pref_count
    if pref_count=$(yq eval '.api.preference | length' "$config_path" 2>/dev/null) && [[ "$pref_count" =~ ^[0-9]+$ ]] && [[ "$pref_count" -gt 0 ]]; then
        PROVIDER_PREFERENCE=()
        local i=0
        while [[ $i -lt $pref_count ]]; do
            local provider
            if provider=$(yq eval ".api.preference[$i]" "$config_path" 2>/dev/null) && [[ -n "$provider" ]]; then
                PROVIDER_PREFERENCE+=("$provider")
            fi
            i=$((i + 1))
        done
    fi
}

# Load layered configuration: config.example.yaml -> user config -> emergency fallback
load_config() {
    local share_dir
    share_dir="$(resolve_share_dir)"

    # Layer 1: Load defaults from config.example.yaml (single source of truth)
    _load_yaml_config "${share_dir}/config.example.yaml"

    # Layer 2: Override with user config if present
    if [[ -f "$CONFIG_FILE" ]]; then
        # Detect stale config schema (pre-v5.23.2 used prompts.rename instead of prompt.template)
        if command -v yq >/dev/null 2>&1; then
            local old_key
            if old_key=$(yq eval '.prompts.rename // ""' "$CONFIG_FILE" 2>/dev/null) && [[ -n "$old_key" ]]; then
                echo "Warning: $CONFIG_FILE uses an outdated schema (prompts.rename)." >&2
                echo "  Run: $SCRIPT_NAME --example-config > $CONFIG_FILE" >&2
            fi
        fi
        _load_yaml_config "$CONFIG_FILE"
    fi

    # Warn if yq is not available
    if ! command -v yq >/dev/null 2>&1; then
        echo "Warning: yq not found, using built-in defaults. Install with: brew install yq" >&2
    fi

    # Emergency fallback: ensure prompt templates are always set
    if [[ -z "$PROMPT_TEMPLATE" ]]; then
        PROMPT_TEMPLATE="Generate a concise, descriptive filename for this {{CATEGORY}} (excluding extension).
Lowercase, hyphens between words. Be specific: preserve key names and identifying details.
Never fabricate information not present in the content.
Output ONLY the filename, nothing else.

Content:
{{CONTENT}}"
    fi

    if [[ -z "$CLASSIFY_PROMPT" ]]; then
        CLASSIFY_PROMPT="Classify this document into exactly one of these categories:
receipt, invoice, letter, report, medical, bank-statement,
tax-document, contract, form, manual, correspondence, other
Output ONLY the category name, nothing else.

Content:
{{CONTENT}}"
    fi

    if [[ -z "$RECEIPT_PROMPT" ]]; then
        RECEIPT_PROMPT="Generate a filename for this {{CATEGORY}} (excluding extension).
Format: YYYY-MM-DD-amount-description
The amount must include exactly two decimal places (e.g. 124.50).
IMPORTANT: Do NOT include a currency code unless the receipt explicitly
shows a non-EUR currency. Most receipts will have no currency code.
Only if the currency is NOT EUR, prefix the amount with the lowercase
currency code (e.g. usd, gbp).
Examples: 2026-01-31-124.50-shower-bench, 2026-01-31-7.99-ups-package
Lowercase, hyphens. Output ONLY the filename, nothing else.

Content:
{{CONTENT}}"
    fi
}

# Ensure the custom Ollama model exists, creating it from Modelfile if needed
ensure_custom_model() {
    # Only relevant when using the custom model name
    if [[ "$OLLAMA_MODEL" != "smart-rename" ]]; then
        return 0
    fi

    # Check Ollama is available
    if ! command -v ollama >/dev/null 2>&1; then
        return 0
    fi

    # Check Ollama service is running
    if ! curl -s http://localhost:11434/api/version >/dev/null 2>&1; then
        return 0
    fi

    # Check if model already exists
    if ollama list 2>/dev/null | grep -q "^smart-rename"; then
        return 0
    fi

    # Find the Modelfile
    local share_dir
    share_dir="$(resolve_share_dir)"
    local modelfile="${share_dir}/smart-rename.Modelfile"

    if [[ ! -f "$modelfile" ]]; then
        echo "Warning: Modelfile not found at $modelfile, falling back to base model" >&2
        OLLAMA_MODEL="qwen2.5:7b"
        return 0
    fi

    echo "Creating custom Ollama model 'smart-rename' (first run only)..." >&2

    # Ensure the base model is available
    if ! ollama list 2>/dev/null | grep -q "^qwen2.5:7b"; then
        echo "Pulling base model qwen2.5:7b..." >&2
        if ! ollama pull "qwen2.5:7b" >&2; then
            echo "Warning: Failed to pull base model, falling back to qwen2.5:7b" >&2
            OLLAMA_MODEL="qwen2.5:7b"
            return 0
        fi
    fi

    if ! ollama create smart-rename -f "$modelfile" >&2; then
        echo "Warning: Failed to create custom model, falling back to qwen2.5:7b" >&2
        OLLAMA_MODEL="qwen2.5:7b"
    fi
}

# --- Provider functions ---

try_ollama() {
    local prompt="$1"

    if ! command -v ollama >/dev/null 2>&1; then
        return 1
    fi

    if ! curl -s http://localhost:11434/api/version >/dev/null 2>&1; then
        echo "Warning: Ollama service not running. Start with: brew services start ollama" >&2
        return 1
    fi

    ensure_custom_model

    # Check if model is available, pull if not
    if ! ollama list 2>/dev/null | grep -q "^${OLLAMA_MODEL}"; then
        echo "Pulling Ollama model '$OLLAMA_MODEL' (first run only)..." >&2
        if ! ollama pull "$OLLAMA_MODEL" >&2; then
            echo "Failed to pull Ollama model '$OLLAMA_MODEL'" >&2
            return 1
        fi
    fi

    echo "Trying Ollama ($OLLAMA_MODEL)..." >&2

    local temp_prompt
    temp_prompt=$(mktemp)
    echo "$prompt" > "$temp_prompt"

    local temp_output
    temp_output=$(mktemp)
    if ! timeout "$API_TIMEOUT" ollama run "$OLLAMA_MODEL" < "$temp_prompt" > "$temp_output" 2>&1; then
        echo "Warning: Ollama request timed out or failed (timeout=${API_TIMEOUT}s)" >&2
    fi
    local ollama_response
    if ! ollama_response=$(sed 's/\x1b\[[0-9;]*[mGKHJ]//g' "$temp_output" | \
        sed 's/\[?[0-9]*[hl]//g' | \
        tr -d '\r' | \
        sed '/^$/d' | \
        grep -v '^\[' | \
        head -1); then
        ollama_response=""
    fi
    rm -f "$temp_output" "$temp_prompt"

    if [[ -n "$ollama_response" ]] && [[ ! "$ollama_response" =~ "Error" ]]; then
        echo "Got response from Ollama" >&2
        echo "$ollama_response"
        return 0
    fi

    echo "Ollama failed" >&2
    if [[ -n "$ollama_response" ]]; then
        echo "  Response: $ollama_response" >&2
    fi
    return 1
}

try_openai() {
    local prompt="$1"

    if [[ -z "${OPENAI_API_KEY:-}" ]]; then
        return 1
    fi

    echo "Using OpenAI ($OPENAI_MODEL)..." >&2
    local json_payload
    json_payload=$(jq -n --arg p "$prompt" --arg m "$OPENAI_MODEL" '{
        model: $m,
        messages: [{role: "user", content: $p}],
        max_tokens: 100
    }')

    local response
    if ! response=$(curl -s --max-time "$API_TIMEOUT" https://api.openai.com/v1/chat/completions \
        -H "Authorization: Bearer $OPENAI_API_KEY" \
        -H "Content-Type: application/json" \
        -d "$json_payload" | jq -r '.choices[0].message.content // empty' | head -1); then
        echo "Warning: OpenAI API request failed" >&2
        response=""
    fi

    if [[ -n "$response" ]]; then
        echo "Got response from OpenAI" >&2
        echo "$response"
        return 0
    fi

    echo "OpenAI failed" >&2
    return 1
}

try_claude() {
    local prompt="$1"

    if [[ -z "${CLAUDE_API_KEY:-}" ]]; then
        return 1
    fi

    echo "Using Claude ($CLAUDE_MODEL)..." >&2
    local json_payload
    json_payload=$(jq -n --arg p "$prompt" --arg m "$CLAUDE_MODEL" '{
        model: $m,
        messages: [{role: "user", content: $p}],
        max_tokens: 100
    }')

    local response
    if ! response=$(curl -s --max-time "$API_TIMEOUT" https://api.anthropic.com/v1/messages \
        -H "x-api-key: $CLAUDE_API_KEY" \
        -H "anthropic-version: 2023-06-01" \
        -H "content-type: application/json" \
        -d "$json_payload" | jq -r '.content[0].text // empty' | head -1); then
        echo "Warning: Claude API request failed" >&2
        response=""
    fi

    if [[ -n "$response" ]]; then
        echo "Got response from Claude" >&2
        echo "$response"
        return 0
    fi

    echo "Claude failed" >&2
    return 1
}

# Try providers in preference order, return first successful response
get_ai_response() {
    local prompt="$1"
    local response=""

    for provider in "${PROVIDER_PREFERENCE[@]}"; do
        case "$provider" in
            ollama)
                response=$(try_ollama "$prompt") && break
                ;;
            openai)
                response=$(try_openai "$prompt") && break
                ;;
            claude)
                response=$(try_claude "$prompt") && break
                ;;
            *)
                echo "Warning: Unknown provider '$provider' in preference list" >&2
                ;;
        esac
    done

    if [[ -n "$response" ]]; then
        echo "$response"
        return 0
    fi
    return 1
}

# Simple function to process a file
process_file() {
    local file="$1"
    local content=""

    # Check file exists
    if [[ ! -f "$file" ]]; then
        echo "Error: File not found: $file" >&2
        return 1
    fi

    # Skip backup files
    if [[ "$file" == *.bak ]]; then
        echo "Skipping backup file: $file" >&2
        return 0
    fi

    # Read file content based on type
    local extension="${file##*.}"
    extension=$(echo "$extension" | tr '[:upper:]' '[:lower:]')

    case "$extension" in
        pdf)
            # Try pdftotext first, fall back to OCR for scanned documents
            if ! command -v pdftotext >/dev/null 2>&1; then
                echo "Error: pdftotext not found. Install poppler for PDF support:" >&2
                echo "  brew install poppler" >&2
                return 1
            fi
            if ! content=$(pdftotext "$file" - 2>/dev/null | head -c "$MAX_CONTENT_LENGTH"); then
                echo "Warning: pdftotext failed to extract text from: $file" >&2
                content=""
            fi
            # Check if we got meaningful text (more than 50 chars, not just whitespace)
            local trimmed
            trimmed=$(echo "$content" | tr -d '[:space:]')
            if [[ ${#trimmed} -lt 50 ]]; then
                # Scanned PDF — try OCR via tesseract + pdftoppm
                if command -v tesseract >/dev/null 2>&1 && command -v pdftoppm >/dev/null 2>&1; then
                    echo "Scanned PDF detected, using OCR..." >&2
                    local ocr_tmp
                    ocr_tmp=$(mktemp -d)
                    if pdftoppm -png -f 1 -l 1 -r 300 "$file" "${ocr_tmp}/page" 2>/dev/null; then
                        local ocr_img
                        ocr_img=$(ls "${ocr_tmp}"/page-*.png 2>/dev/null | head -1)
                        if [[ -n "$ocr_img" ]]; then
                            if ! content=$(tesseract "$ocr_img" stdout 2>/dev/null | head -c "$MAX_CONTENT_LENGTH"); then
                                echo "Warning: OCR (tesseract) failed for: $file" >&2
                                content=""
                            fi
                        else
                            echo "Warning: PDF page rendering produced no image for: $file" >&2
                        fi
                    else
                        echo "Warning: PDF page rendering (pdftoppm) failed for: $file" >&2
                    fi
                    rm -rf "$ocr_tmp"
                else
                    echo "Warning: PDF appears scanned but tesseract/pdftoppm not available for OCR" >&2
                    echo "  Install with: brew install tesseract poppler" >&2
                fi
            fi
            ;;
        docx|doc)
            # Microsoft Word — pandoc with unzip/xmllint fallback for DOCX
            if command -v pandoc >/dev/null 2>&1; then
                if ! content=$(pandoc --to=plain --wrap=none "$file" 2>/dev/null | head -c "$MAX_CONTENT_LENGTH"); then
                    echo "Warning: pandoc failed to extract text from: $file" >&2
                    content=""
                fi
            elif [[ "$extension" == "docx" ]]; then
                # DOCX is a ZIP archive — extract text from word/document.xml
                local docx_tmp
                docx_tmp=$(mktemp -d)
                if unzip -q "$file" -d "$docx_tmp" 2>/dev/null; then
                    if [[ -f "$docx_tmp/word/document.xml" ]]; then
                        if ! content=$(xmllint --format "$docx_tmp/word/document.xml" 2>/dev/null | \
                            sed 's/<[^>]*>//g' | tr -s ' \n' ' ' | head -c "$MAX_CONTENT_LENGTH"); then
                            echo "Warning: xmllint failed to parse DOCX content from: $file" >&2
                            content=""
                        fi
                    else
                        echo "Warning: DOCX archive missing word/document.xml: $file" >&2
                    fi
                else
                    echo "Warning: Failed to unzip DOCX file: $file" >&2
                fi
                rm -rf "$docx_tmp"
            else
                echo "Error: .doc files require pandoc. Install with: brew install pandoc" >&2
                return 1
            fi
            ;;
        xlsx)
            # Microsoft Excel — pandoc with unzip/xmllint fallback
            if command -v pandoc >/dev/null 2>&1; then
                if ! content=$(pandoc --to=plain --wrap=none "$file" 2>/dev/null | head -c "$MAX_CONTENT_LENGTH"); then
                    echo "Warning: pandoc failed to extract text from: $file" >&2
                    content=""
                fi
            else
                # XLSX is a ZIP archive — extract sheet names and shared strings
                local xlsx_tmp
                xlsx_tmp=$(mktemp -d)
                if unzip -q "$file" -d "$xlsx_tmp" 2>/dev/null; then
                    local xlsx_content=""
                    if [[ -f "$xlsx_tmp/xl/workbook.xml" ]]; then
                        local sheet_names
                        if sheet_names=$(xmllint --format "$xlsx_tmp/xl/workbook.xml" 2>/dev/null | \
                            grep -o 'name="[^"]*"' | sed 's/name="//;s/"//' | head -5 | tr '\n' ' '); then
                            xlsx_content+="Sheets: ${sheet_names} "
                        fi
                    fi
                    if [[ -f "$xlsx_tmp/xl/sharedStrings.xml" ]]; then
                        local shared_strings
                        if shared_strings=$(xmllint --format "$xlsx_tmp/xl/sharedStrings.xml" 2>/dev/null | \
                            sed 's/<[^>]*>//g' | tr -s ' \n' ' ' | head -c "$MAX_CONTENT_LENGTH"); then
                            xlsx_content+="Content: ${shared_strings}"
                        fi
                    fi
                    content="$xlsx_content"
                else
                    echo "Warning: Failed to unzip XLSX file: $file" >&2
                fi
                rm -rf "$xlsx_tmp"
            fi
            ;;
        pptx)
            # Microsoft PowerPoint — pandoc with unzip/xmllint fallback
            if command -v pandoc >/dev/null 2>&1; then
                if ! content=$(pandoc --to=plain --wrap=none "$file" 2>/dev/null | head -c "$MAX_CONTENT_LENGTH"); then
                    echo "Warning: pandoc failed to extract text from: $file" >&2
                    content=""
                fi
            else
                # PPTX is a ZIP archive — extract slide text
                local pptx_tmp
                pptx_tmp=$(mktemp -d)
                if unzip -q "$file" -d "$pptx_tmp" 2>/dev/null; then
                    local pptx_content=""
                    for slide in "$pptx_tmp"/ppt/slides/slide*.xml; do
                        [[ -f "$slide" ]] || continue
                        local slide_text
                        if slide_text=$(xmllint --format "$slide" 2>/dev/null | \
                            sed 's/<[^>]*>//g' | tr -s ' \n' ' ' | head -c 500); then
                            pptx_content+="${slide_text} "
                        fi
                    done
                    content=$(echo "$pptx_content" | head -c "$MAX_CONTENT_LENGTH")
                else
                    echo "Warning: Failed to unzip PPTX file: $file" >&2
                fi
                rm -rf "$pptx_tmp"
            fi
            ;;
        rtf)
            # Rich Text Format — pandoc with sed fallback
            if command -v pandoc >/dev/null 2>&1; then
                if ! content=$(pandoc --to=plain --wrap=none "$file" 2>/dev/null | head -c "$MAX_CONTENT_LENGTH"); then
                    echo "Warning: pandoc failed to extract text from: $file" >&2
                    content=""
                fi
            else
                # Strip RTF control codes to extract plain text
                if ! content=$(sed 's/{[^}]*}//g; s/\\[a-z]*[0-9]*//g; s/\\[^a-zA-Z]//g' "$file" | \
                    tr -s ' \n' ' ' | head -c "$MAX_CONTENT_LENGTH"); then
                    echo "Warning: Failed to extract text from RTF file: $file" >&2
                    content=""
                fi
            fi
            ;;
        odt|ods|odp)
            # OpenDocument formats — pandoc with unzip/xmllint fallback
            if command -v pandoc >/dev/null 2>&1; then
                if ! content=$(pandoc --to=plain --wrap=none "$file" 2>/dev/null | head -c "$MAX_CONTENT_LENGTH"); then
                    echo "Warning: pandoc failed to extract text from: $file" >&2
                    content=""
                fi
            else
                # ODF files are ZIP archives — extract content.xml
                local odf_tmp
                odf_tmp=$(mktemp -d)
                if unzip -q "$file" -d "$odf_tmp" 2>/dev/null; then
                    local odf_content=""
                    if [[ -f "$odf_tmp/meta.xml" ]]; then
                        local odf_title
                        if odf_title=$(xmllint --format "$odf_tmp/meta.xml" 2>/dev/null | \
                            sed -n 's/.*<dc:title>\(.*\)<\/dc:title>.*/\1/p' | head -1); then
                            if [[ -n "$odf_title" ]]; then
                                odf_content+="Title: $odf_title "
                            fi
                        fi
                    fi
                    if [[ -f "$odf_tmp/content.xml" ]]; then
                        local odf_body
                        if odf_body=$(xmllint --format "$odf_tmp/content.xml" 2>/dev/null | \
                            sed 's/<[^>]*>//g' | tr -s ' \n' ' ' | head -c "$MAX_CONTENT_LENGTH"); then
                            odf_content+="$odf_body"
                        fi
                    fi
                    content="$odf_content"
                else
                    echo "Warning: Failed to unzip ODF file: $file" >&2
                fi
                rm -rf "$odf_tmp"
            fi
            ;;
        eml)
            # Email files (RFC 2822 format) — parse headers and body
            local eml_subject eml_from eml_date eml_body
            eml_subject=$(grep -i "^Subject:" "$file" 2>/dev/null | head -1 | sed 's/^[Ss]ubject: *//') || eml_subject=""
            eml_from=$(grep -i "^From:" "$file" 2>/dev/null | head -1 | sed 's/^[Ff]rom: *//' | sed 's/<.*>//') || eml_from=""
            eml_date=$(grep -i "^Date:" "$file" 2>/dev/null | head -1 | sed 's/^[Dd]ate: *//') || eml_date=""
            if ! eml_body=$(awk '/^$/{p=1; next} p{print}' "$file" | head -c "$MAX_CONTENT_LENGTH"); then
                eml_body=""
            fi
            if [[ -z "$eml_subject" ]] && [[ -z "$eml_from" ]] && [[ -z "$eml_date" ]]; then
                echo "Warning: No RFC 2822 headers found in: $file" >&2
            fi
            content="Subject: ${eml_subject} From: ${eml_from} Date: ${eml_date} Body: ${eml_body}"
            ;;
        msg)
            # Outlook MSG files — require msgconvert to convert to EML first
            if command -v msgconvert >/dev/null 2>&1; then
                local msg_tmp
                msg_tmp=$(mktemp)
                if msgconvert --outfile="$msg_tmp" "$file" 2>/dev/null; then
                    local msg_subject msg_from msg_date msg_body
                    msg_subject=$(grep -i "^Subject:" "$msg_tmp" 2>/dev/null | head -1 | sed 's/^[Ss]ubject: *//') || msg_subject=""
                    msg_from=$(grep -i "^From:" "$msg_tmp" 2>/dev/null | head -1 | sed 's/^[Ff]rom: *//' | sed 's/<.*>//') || msg_from=""
                    msg_date=$(grep -i "^Date:" "$msg_tmp" 2>/dev/null | head -1 | sed 's/^[Dd]ate: *//') || msg_date=""
                    if ! msg_body=$(awk '/^$/{p=1; next} p{print}' "$msg_tmp" | head -c "$MAX_CONTENT_LENGTH"); then
                        msg_body=""
                    fi
                    content="Subject: ${msg_subject} From: ${msg_from} Date: ${msg_date} Body: ${msg_body}"
                else
                    echo "Warning: msgconvert failed to process: $file" >&2
                fi
                rm -f "$msg_tmp"
            else
                echo "Error: .msg files require msgconvert. Install with: cpan Email::Outlook::Message" >&2
                return 1
            fi
            ;;
        jpg|jpeg|png|gif|bmp|tiff|webp)
            # For images, we'd need vision API support
            echo "Image files require AI with vision support (not yet implemented)" >&2
            return 1
            ;;
        *)
            # Plain text files
            content=$(head -c "$MAX_CONTENT_LENGTH" "$file" 2>/dev/null) || {
                echo "Error reading file: $file" >&2
                return 1
            }
            ;;
    esac

    if [[ -z "$content" ]]; then
        echo "Error: No readable content could be extracted from: $file" >&2
        echo "  Possible causes: file is empty, corrupted, password-protected, or in an unsupported encoding" >&2
        return 1
    fi

    # Step 1: Classify document type
    local category="other"
    if [[ -n "$CLASSIFY_PROMPT" ]]; then
        local classify_prompt="$CLASSIFY_PROMPT"
        classify_prompt="${classify_prompt//\{\{CONTENT\}\}/$content}"
        local raw_category=""
        if raw_category=$(get_ai_response "$classify_prompt"); then
            # Normalise: lowercase, strip whitespace and punctuation
            raw_category=$(echo "$raw_category" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]' | tr -cd '[:alnum:]-')
            # Validate against known categories
            case "$raw_category" in
                receipt|invoice|letter|report|medical|bank-statement|tax-document|contract|form|manual|correspondence|other)
                    category="$raw_category"
                    ;;
                *)
                    category="other"
                    ;;
            esac
        fi
        echo "Classified as: $category" >&2
    fi

    # Step 2: Build naming prompt based on document category
    local naming_template
    if [[ "$category" == "receipt" || "$category" == "invoice" ]] && [[ -n "$RECEIPT_PROMPT" ]]; then
        naming_template="$RECEIPT_PROMPT"
    else
        naming_template="$PROMPT_TEMPLATE"
    fi

    local prompt="$naming_template"
    prompt="${prompt//\{\{CONTENT\}\}/$content}"
    prompt="${prompt//\{\{FILENAME\}\}/$file}"
    prompt="${prompt//\{\{BASE_CURRENCY\}\}/$BASE_CURRENCY}"
    prompt="${prompt//\{\{CATEGORY\}\}/$category}"

    # Get AI response using preference order
    local new_name=""
    if ! new_name=$(get_ai_response "$prompt") || [[ -z "$new_name" ]]; then
        echo "Error: Could not generate filename (no AI service available)" >&2
        return 1
    fi

    # Clean the name (keep periods for decimal amounts)
    new_name=$(echo "$new_name" | tr -d '"' | tr ' ' '-' | tr -cd '[:alnum:].-' | tr '[:upper:]' '[:lower:]')

    # Strip leading/trailing hyphens and collapse multiple consecutive hyphens
    new_name=$(echo "$new_name" | sed 's/^-*//; s/-*$//; s/-\{2,\}/-/g')

    # Normalise receipt/invoice amounts to always have two decimal places
    # Pattern: YYYY-MM-DD-amount-description where amount may be malformed
    if [[ "$new_name" =~ ^([0-9]{4}-[0-9]{2}-[0-9]{2})-([0-9]+)-([0-9]{2})-(.+)$ ]]; then
        # Case: hyphen used as decimal separator (e.g., 198-75 instead of 198.75)
        local date_part="${BASH_REMATCH[1]}"
        local amount_whole="${BASH_REMATCH[2]}"
        local amount_decimal="${BASH_REMATCH[3]}"
        local rest="${BASH_REMATCH[4]}"
        new_name="${date_part}-${amount_whole}.${amount_decimal}-${rest}"
    elif [[ "$new_name" =~ ^([0-9]{4}-[0-9]{2}-[0-9]{2})-([0-9]+)-([^0-9].*)$ ]]; then
        # Case: whole number without decimals (e.g., 100 instead of 100.00)
        local date_part="${BASH_REMATCH[1]}"
        local amount="${BASH_REMATCH[2]}"
        local rest="${BASH_REMATCH[3]}"
        new_name="${date_part}-${amount}.00-${rest}"
    elif [[ "$new_name" =~ ^([0-9]{4}-[0-9]{2}-[0-9]{2})-([0-9]+\.[0-9])-([^0-9].*)$ ]]; then
        # Case: single decimal place (e.g., 100.5 instead of 100.50)
        local date_part="${BASH_REMATCH[1]}"
        local amount="${BASH_REMATCH[2]}"
        local rest="${BASH_REMATCH[3]}"
        new_name="${date_part}-${amount}0-${rest}"
    fi

    # Reject 0.00 amounts - these are not real invoices/receipts
    # Convert back to descriptive format by removing the date-amount prefix
    if [[ "$new_name" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}-0\.00-(.+)$ ]]; then
        new_name="${BASH_REMATCH[1]}"
        echo "Note: Removed invalid 0.00 amount from filename" >&2
    fi

    # Add extension
    local ext="${file##*.}"
    if [[ "$ext" != "$file" ]]; then
        new_name="${new_name}.${ext}"
    fi

    echo "Generated name: $new_name" >&2

    # Check if source and target are the same file
    if [[ "$file" == "$new_name" ]]; then
        echo "File already has optimal name, skipping" >&2
        return 0
    fi

    # Check if target file exists and create backup if needed
    if [[ -e "$new_name" ]]; then
        # Find next available backup number
        local backup_base="${new_name}"
        local backup_num=0
        local backup_name="${backup_base}.bak"

        # Check for existing backups (.bak, .1.bak, .2.bak, etc.)
        if [[ -e "$backup_name" ]]; then
            backup_num=1
            while [[ -e "${backup_base}.${backup_num}.bak" ]]; do
                backup_num=$((backup_num + 1))
            done
            backup_name="${backup_base}.${backup_num}.bak"
        fi

        echo "Target file exists, creating backup: $new_name -> $backup_name" >&2
        mv "$new_name" "$backup_name" || {
            echo "Failed to create backup: $backup_name" >&2
            return 1
        }
    fi

    # Confirm rename unless auto mode
    if [[ "$AUTO_RENAME" != "true" ]]; then
        echo "  ${file} ->"
        echo -n "  ${new_name} "
        read -p "(y/N):" -n 1 -r
        echo  # Add newline after single character input
        if [[ ! "$REPLY" =~ ^[Yy]$ ]]; then
            echo "Skipped"
            return 0
        fi
    fi

    # Rename the file
    mv "$file" "$new_name" && echo "Renamed: $file -> $new_name"
}

# Show help
show_help() {
    cat <<EOF
USAGE: $SCRIPT_NAME [OPTIONS] PATTERN [PATTERN...]

DESCRIPTION:
  AI-powered file renaming tool that generates intelligent filenames

OPTIONS:
  -h, --help        Show this help message
  -v, --version     Show version
  -y, --yes         Auto-rename without confirmation
  -r, --recursive   Search recursively
  -g, --glob        Use glob pattern instead of regex

CONFIGURATION:
  --example-config  Print the reference config to stdout and exit

  Defaults are built in. To customise, create a config file:
    $SCRIPT_NAME --example-config > ~/.config/smart-rename/config.yaml

EXAMPLES:
  $SCRIPT_NAME 'scan.*\.pdf'        # Find files matching regex
  $SCRIPT_NAME -g '*.txt'           # Find files matching glob
  $SCRIPT_NAME -r 'invoice'         # Recursive search (regex)
  $SCRIPT_NAME -y -g document.pdf   # Specific file, auto-rename

EOF
}

# Main
if [[ $# -eq 0 ]]; then
    show_help
    exit 1
fi

# Parse arguments
AUTO_RENAME=false
RECURSIVE=false
USE_GLOB=false
PATTERNS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        -v|--version)
            echo "$SCRIPT_NAME $VERSION"
            exit 0
            ;;
        --example-config)
            _share_dir="$(resolve_share_dir)"
            _example_file="${_share_dir}/config.example.yaml"
            if [[ -f "$_example_file" ]]; then
                cat "$_example_file"
            else
                echo "Error: config.example.yaml not found in $_share_dir" >&2
                exit 1
            fi
            exit 0
            ;;
        -y|--yes)
            AUTO_RENAME=true
            shift
            ;;
        -r|--recursive)
            RECURSIVE=true
            shift
            ;;
        -g|--glob)
            USE_GLOB=true
            shift
            ;;
        *)
            PATTERNS+=("$1")
            shift
            ;;
    esac
done

if [[ ${#PATTERNS[@]} -eq 0 ]]; then
    echo "Error: No pattern specified"
    show_help
    exit 1
fi

# Load configuration
load_config

# Process all patterns
failed_files=()
success_count=0
total_count=0

for PATTERN in "${PATTERNS[@]}"; do
    # Check if pattern is a file
    if [[ -f "$PATTERN" ]]; then
        # Single file mode
        total_count=$((total_count + 1))
        if ! process_file "$PATTERN"; then
            failed_files+=("$PATTERN")
        else
            success_count=$((success_count + 1))
        fi
    else
        # Pattern matching mode - find files
        echo "Searching for files matching: $PATTERN" >&2

        # Build fd arguments
        FD_ARGS=()

        # Add depth control
        if [[ "$RECURSIVE" == "false" ]]; then
            FD_ARGS+=(--max-depth 1)
        fi

        # Add pattern based on mode
        if [[ "$USE_GLOB" == "true" ]]; then
            FD_ARGS+=(--glob "$PATTERN")
        else
            # Default is regex
            FD_ARGS+=("$PATTERN")
        fi

        FD_ARGS+=(--type f .)

        # Use fd to find files (empty result if fd fails — handled below)
        fd_output=""
        if ! fd_output=$(fd "${FD_ARGS[@]}" 2>/dev/null); then
            fd_output=""
        fi
        mapfile -t files <<< "$fd_output"
        # Remove empty element from empty heredoc
        if [[ ${#files[@]} -eq 1 ]] && [[ -z "${files[0]}" ]]; then
            files=()
        fi

        if [[ ${#files[@]} -eq 0 ]]; then
            echo "No files found matching pattern: $PATTERN" >&2
            continue
        fi

        echo "Found ${#files[@]} files:" >&2
        for file in "${files[@]}"; do
            echo "  - $file" >&2
        done
        echo "" >&2

        # Process each file
        for file in "${files[@]}"; do
            total_count=$((total_count + 1))
            if ! process_file "$file"; then
                failed_files+=("$file")
            else
                success_count=$((success_count + 1))
            fi
            echo "" >&2
        done
    fi
done

# Print summary when multiple files were processed
if [[ $total_count -gt 1 ]]; then
    echo "Processed ${total_count} file(s): ${success_count} succeeded, ${#failed_files[@]} failed" >&2
    if [[ ${#failed_files[@]} -gt 0 ]]; then
        echo "Failed:" >&2
        for f in "${failed_files[@]}"; do
            echo "  - $f" >&2
        done
    fi
fi

# Exit non-zero if any files failed
if [[ ${#failed_files[@]} -gt 0 ]]; then
    exit 1
fi
